# Production builds target GitHub Pages (a static host with no backend).
# These flags make `npm run build` / `npm run deploy` produce a self-contained
# demo site (mock API) using HashRouter so deep links never 404 on Pages.
# The CI workflow also sets these explicitly; either path yields the same build.
REACT_APP_DEMO_MODE=true
REACT_APP_HASH_ROUTER=true
